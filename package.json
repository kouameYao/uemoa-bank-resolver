{
  "name": "uemoa-bank-resolver",
  "version": "0.1.1",
  "description": "Identify the bank behind any UEMOA / BCEAO IBAN or RIB (Bénin, Burkina, Côte d'Ivoire, Guinée-Bissau, Mali, Niger, Sénégal, Togo). Validation, decomposition and offline bank lookup. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "node examples/demo.mjs",
    "test:rib": "node examples/test-rib.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:exports": "attw --pack . && publint",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "iban",
    "rib",
    "bic",
    "bank",
    "uemoa",
    "bceao",
    "umoa",
    "west-africa",
    "afrique",
    "cote-divoire",
    "senegal",
    "benin",
    "burkina",
    "mali",
    "niger",
    "togo",
    "guinee-bissau",
    "iban-validation",
    "bank-lookup"
  ],
  "author": "Jean Kouamé",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouameYao/uemoa-bank-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/kouameYao/uemoa-bank-resolver/issues"
  },
  "homepage": "https://github.com/kouameYao/uemoa-bank-resolver#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^2.4.16",
    "@vitest/coverage-v8": "^4.1.8",
    "publint": "^0.3.21",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
