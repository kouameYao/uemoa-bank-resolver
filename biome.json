{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!**/node_modules", "!**/examples", "!**/docs"]
  },
  "overrides": [
    {
      "includes": ["**/src/data/registry.ts"],
      "formatter": { "enabled": false }
    }
  ]
}
